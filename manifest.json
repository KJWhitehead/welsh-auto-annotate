{
  "manifest_version": 3,
  "name": "Welsh Auto-Annotation Tool",
  "version": "1.0",
  "description": "Injects hover tooltips over processed Welsh text using offline curriculum dictionaries.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Annotate Page"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["assets/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dictionaries/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}

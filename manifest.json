{
  "manifest_version": 3,
  "name": "Welsh Auto-Annotation Tool",
  "version": "1.0",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "dictionaries/mynediad.js",
        "dictionaries/sylfaen.js",
        "dictionaries/canolradd.js",
        "dictionaries/bbc.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

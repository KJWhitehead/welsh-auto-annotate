{
  "manifest_version": 3,
  "name": "Welsh Auto-Annotation Tool",
  "version": "2.1",
  "description": "Injects hover tooltips over processed Welsh text using offline curriculum dictionaries.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "assets/icon48.png",
    "32": "assets/icon48.png",
    "48": "assets/icon48.png",
    "128": "assets/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Annotate Page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon48.png",
      "32": "assets/icon48.png",
      "48": "assets/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["assets/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dictionaries/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
